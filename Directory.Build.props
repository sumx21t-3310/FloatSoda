<Project>
    <PropertyGroup>
        <Version>0.5.0</Version>
    </PropertyGroup>

    <PropertyGroup>
        <LangVersion>14</LangVersion>
        <AnalysisLevel>10.0</AnalysisLevel>
    </PropertyGroup>

    <PropertyGroup>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
        <WarningsAsErrors>$(WarningsAsErrors);RCS1248;RS0016;RS0017</WarningsAsErrors>
    </PropertyGroup>

    <PropertyGroup>
        <Authors>Sumx21t</Authors>
        <Copyright>Copyright (c) 2026 Sumx21t</Copyright>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/sumx21t-3310/FloatSoda</PackageProjectUrl>
        <RepositoryUrl>https://github.com/sumx21t-3310/FloatSoda</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageTags>steamvr;openvr;overlay;vr;ui;skiasharp;declarative-ui</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Roslynator.Analyzers" Version="5.0.1" PrivateAssets="all" />
    </ItemGroup>

    <!-- NuGet に公開するパッケージの公開 API を PublicAPI.Shipped.txt / PublicAPI.Unshipped.txt で追跡する -->
    <ItemGroup Condition="$(MSBuildProjectDirectory.StartsWith('$(MSBuildThisFileDirectory)src')) And '$(IsPackable)' != 'false'">
        <PackageReference
            Include="Microsoft.CodeAnalysis.PublicApiAnalyzers"
            Version="5.6.0"
            PrivateAssets="all"
        />
    </ItemGroup>

    <ItemGroup>
        <None
            Include="$(MSBuildThisFileDirectory)README.md"
            Pack="true"
            PackagePath="\"
            Visible="false"
        />
    </ItemGroup>
</Project>
